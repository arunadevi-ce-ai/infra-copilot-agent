# Terraform
# Include micro-backend connection files if they contain secrets
.terraform.lock.hcl
# Local .terraform directories (contains provider binaries and modules)
Iac/.terraform/*
Iac/persistent/.terraform/*
# .tfstate files (contains sensitive infrastructure data and secrets)
Iac/*.tfstate    
Iac/*.tfstate.*
Iac/*.tfstate.backup
Iac/persistent/*.tfstate    
Iac/persistent/*.tfstate.*
Iac/persistent/*.tfstate.backup
# Exclude all .tfvars files (contains sensitive password/keys data)
Iac/terraform.tfvars
Iac/persistent/terraform.tfvars
Iac/*.tfvars
Iac/*.tfvars.json
Iac/.env
Iac/deploy.sh
Iac/set_github_var_secrets.sh
# Kubernetes
k8s_manifest/secret.yaml

# Python / agent
agent_code/.env
agent_code/__pycache__/
agent_code/*.pyc
agent_code/build_script.sh

# General
.vscode/
